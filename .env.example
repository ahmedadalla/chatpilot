# ChatPilot Environment Variables Template

# Application Environment
NODE_ENV=development
PORT=3001
WEB_PORT=3000
WHATSAPP_WORKER_PORT=3002

# Database Configuration (Two-DSN Least-Privilege Model)
# Runtime role: chatpilot_app (No BYPASSRLS, not a superuser)
DATABASE_URL=postgresql://chatpilot_app:app_secret_pass@localhost:5432/chatpilot?schema=public

# Migrator role: chatpilot_migrator (Runs migrations, owns tables)
DATABASE_URL_MIGRATOR=postgresql://chatpilot_migrator:migrator_secret_pass@localhost:5432/chatpilot?schema=public

# Redis 7 Configuration (BullMQ, pub/sub, rate limiting)
REDIS_URL=redis://localhost:6379

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long_for_security
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=604800

# Envelope Encryption Key (KMS / Secrets Service)
KMS_MASTER_KEY=base64_master_key_for_secrets_envelope_encryption_32b_min==

# Object Storage (S3 / Cloudflare R2 compatible)
S3_BUCKET=chatpilot-uploads
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Localization & Regional Defaults (Q-REQ-6)
DEFAULT_COUNTRY=EG
DEFAULT_CURRENCY=EGP
DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_LOCALE=ar-EG
DEFAULT_CALLING_CODE=+20
