# ==============================================================================
# ChatPilot Production Environment Configuration (.env.production)
# ==============================================================================
# DO NOT COMMIT THE ACTUAL .env.production FILE TO GIT REPOSITORY.
# Protect this file with: chmod 600 .env.production
# Generate secure keys with: openssl rand -base64 32
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3001
WEB_PORT=3000
WHATSAPP_WORKER_PORT=3002

# ------------------------------------------------------------------------------
# PostgreSQL 17 + pgvector (Two-DSN Least Privilege Model - D-3)
# ------------------------------------------------------------------------------
POSTGRES_DB=chatpilot
POSTGRES_USER=chatpilot_migrator
POSTGRES_PASSWORD=GENERATE_STRONG_MIGRATOR_PASSWORD_HERE

# Database URLs used by application containers (via internal Docker bridge network)
# 1. Migrator DSN (used only during DDL and migrations)
DATABASE_URL_MIGRATOR=postgresql://chatpilot_migrator:GENERATE_STRONG_MIGRATOR_PASSWORD_HERE@postgres:5432/chatpilot?schema=public

# 2. Runtime Application DSN (chatpilot_app role: NO BYPASSRLS, not a superuser)
DATABASE_URL=postgresql://chatpilot_app:GENERATE_STRONG_APP_PASSWORD_HERE@postgres:5432/chatpilot?schema=public

# ------------------------------------------------------------------------------
# Redis 7 Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:GENERATE_STRONG_REDIS_PASSWORD_HERE@redis:6379

# ------------------------------------------------------------------------------
# Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# Minimum 32 characters for HMAC SHA-256 signing
JWT_SECRET=GENERATE_RANDOM_32_CHAR_JWT_SECRET_STRING_HERE
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=604800

# Envelope Encryption Master Key (D-13) - 256-bit base64 key
KMS_MASTER_KEY=GENERATE_BASE64_256_BIT_MASTER_KEY_HERE==

# ------------------------------------------------------------------------------
# S3 / Cloudflare R2 Object Storage
# ------------------------------------------------------------------------------
S3_BUCKET=chatpilot-production-uploads
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=YOUR_S3_OR_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_OR_R2_SECRET_ACCESS_KEY

# ------------------------------------------------------------------------------
# Regional & Localization Defaults (Q-REQ-6)
# ------------------------------------------------------------------------------
DEFAULT_COUNTRY=EG
DEFAULT_CURRENCY=EGP
DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_LOCALE=ar-EG
DEFAULT_CALLING_CODE=+20

# ------------------------------------------------------------------------------
# Frontend & BFF Integration Configuration
# ------------------------------------------------------------------------------
# Internal bridge URL used by Next.js BFF server routes to reach the NestJS API
INTERNAL_API_URL=http://api:3001/api/v1

# Public WebSocket URL used by client browsers to reach the Socket.IO gateway
NEXT_PUBLIC_WS_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# Initial Super Admin Bootstrap (Initial Launch Only)
# Remove BOOTSTRAP_OVERRIDE after first successful login
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=SetAStrongInitialSuperAdminPassword123!
BOOTSTRAP_OVERRIDE=true
