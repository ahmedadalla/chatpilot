FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache git python3 make g++ libc6-compat openssl
RUN npm install -g pnpm@9.7.0

FROM base AS builder
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json tsconfig.base.json .eslintrc.js .prettierrc ./
COPY prisma/ ./prisma/
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
ENV PRISMA_GENERATE_SKIP_AUTOINSTALL=1
RUN pnpm install --frozen-lockfile
RUN pnpm exec prisma generate --schema=prisma/schema.prisma
RUN pnpm --filter "./packages/*" build
RUN pnpm --filter @chatpilot/api build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# Copy only the parts needed for production runtime
COPY --from=builder /app/apps /app/apps
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/prisma /app/prisma
COPY --from=builder /app/pnpm-workspace.yaml /app/package.json /app/pnpm-lock.yaml /app/turbo.json /app/
# Fresh install using the shared .pnpm store from builder — recreates all symlinks
RUN pnpm install --frozen-lockfile --prod
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
