FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache git python3 make g++ libc6-compat
RUN npm install -g pnpm@9.7.0

FROM base AS builder
WORKDIR /app
COPY pnpm-workspace.yaml package.json turbo.json tsconfig.base.json .eslintrc.js .prettierrc ./
COPY prisma/ ./prisma/
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @chatpilot/database exec prisma generate --schema=../../prisma/schema.prisma
RUN pnpm --filter @chatpilot/api build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app /app
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
